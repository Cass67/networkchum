{
  "name": "networkchum",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "start": "./start.sh",
    "start:lan": "./start.sh lan",
    "dev": "concurrently -k -n api,web,bridge \"npm run dev --workspace @networkchum/api\" \"npm run dev --workspace @networkchum/web\" \"npm run dev:bridge\"",
    "dev:reset": "pkill -f \"tsx watch src/server.ts\"; pkill -f \"vite --port 5173 --strictPort\"; npm run dev",
    "dev:api": "npm run dev --workspace @networkchum/api",
    "dev:web": "npm run dev --workspace @networkchum/web",
    "dev:bridge": "./scripts/run-native-console-bridge.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "fast-uri": "^4.2.1",
    "fast-xml-builder": "^1.3.1",
    "fastify": "^5.8.5",
    "find-my-way": "^9.9.0",
    "ws": "^8.21.0"
  }
}
